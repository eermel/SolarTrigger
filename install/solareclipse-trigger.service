[Unit]
Description=SolarEclipse Trigger (déclenchement photo)
# Le trigger est lancé MANUELLEMENT depuis l'UI web (bouton START).
# Ce service est présent pour permettre un lancement en ligne de commande
# si besoin, mais il ne démarre PAS automatiquement au boot (no [Install]).
# Pour lancer manuellement :
#   sudo systemctl start solareclipse-trigger
# Pour arrêter :
#   sudo systemctl stop solareclipse-trigger
After=solareclipse-portal.service
Wants=solareclipse-portal.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/python_solareclipsetrigger

# Vérifie que todayeclipse.json existe avant de lancer
ExecStartPre=/bin/test -f /home/pi/python_solareclipsetrigger/todayeclipse.json

ExecStart=/home/pi/python_solareclipsetrigger/venv/bin/python3 \
    /home/pi/python_solareclipsetrigger/eclipse_trigger.py \
    --file /home/pi/python_solareclipsetrigger/todayeclipse.json

# Watchdog : redémarre en cas de crash (pas en fin normale)
Restart=on-failure
RestartSec=3
SuccessExitStatus=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=solareclipse-trigger

# Pas de [Install] — ne démarre PAS au boot automatiquement
# Le portail Flask gère le démarrage via subprocess (bouton START de l'UI)

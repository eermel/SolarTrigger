#!/bin/bash
set -euo pipefail

APP_USER="${SOLARTRIGGER_USER:-${SUDO_USER:-airone}}"
USER_HOME="$(getent passwd "$APP_USER" | cut -d: -f6)"
[[ -n "$USER_HOME" ]]

BASE="$USER_HOME/solartrigger"
RELEASES="$BASE/releases"
SHARED_VAR="$BASE/var"
SHARED_VENV="$BASE/venv"
ACTIVE="$USER_HOME/solar-eclipse-trigger-prod"

log() {
    printf '%s\n' "$*"
}

alink() {
    local target=$1
    local link=$2
    local tmp="${link}.new.$$"
    rm -f -- "$tmp"
    ln -s -- "$target" "$tmp"
    mv -Tf -- "$tmp" "$link"
}

manifest_for_legacy() {
    local version=$1
    local destination=$2
    local commit=""

    if [[ -f "$destination/BUILD_COMMIT" ]]; then
        commit=$(tr -d '[:space:]' < "$destination/BUILD_COMMIT")
    fi

    /usr/bin/python3 - "$destination/RELEASE_MANIFEST.json" "$version" "$commit" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
version = sys.argv[2]
commit = sys.argv[3] or None
path.write_text(
    json.dumps(
        {
            "package_type": "solartrigger-release",
            "schema_version": 2,
            "version": version,
            "build_commit": commit,
            "migrated_legacy": True,
            "files": {},
        },
        indent=2,
        sort_keys=True,
    )
    + "\n",
    encoding="utf-8",
)
PY
}

migrate_legacy_layout() {
    local stamp
    local version
    local destination

    mkdir -p -- "$BASE" "$RELEASES"

    if [[ -e "$ACTIVE" && ! -L "$ACTIVE" ]]; then
        stamp=$(date -u +%Y%m%d-%H%M%S)
        version="legacy-$stamp"
        destination="$RELEASES/$version"
        [[ ! -e "$destination" ]]

        log "Migrating legacy installation to $destination"
        mv -- "$ACTIVE" "$destination"

        # Restore the production pathname immediately. Running services may
        # still resolve absolute paths while var/venv move to shared storage.
        alink "$destination" "$ACTIVE"

        if [[ -e "$destination/var" && ! -L "$destination/var" ]]; then
            [[ ! -e "$SHARED_VAR" ]]
            mv -- "$destination/var" "$SHARED_VAR"
        fi
        if [[ -e "$destination/venv" && ! -L "$destination/venv" ]]; then
            [[ ! -e "$SHARED_VENV" ]]
            mv -- "$destination/venv" "$SHARED_VENV"
        fi

        mkdir -p -- "$SHARED_VAR"
        [[ -d "$SHARED_VENV" ]]

        if [[ ! -L "$destination/var" ]]; then
            ln -s -- "$SHARED_VAR" "$destination/var"
        fi
        if [[ ! -L "$destination/venv" ]]; then
            ln -s -- "$SHARED_VENV" "$destination/venv"
        fi

        manifest_for_legacy "$version" "$destination"
    fi
}

validate_and_extract() {
    local package=$1
    local destination=$2

    /usr/bin/python3 - "$package" "$destination" <<'PY'
import hashlib
import json
from pathlib import Path, PurePosixPath
import re
import stat
import sys
import zipfile

package = Path(sys.argv[1])
destination = Path(sys.argv[2])
version_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$")
required = {
    "app.py",
    "wsgi.py",
    "backend/runtime_daemon.py",
    "scripts/eclipse_trigger.py",
    "templates/index.html",
    "static/js/solartrigger.js",
    "Sounds/contact.wav",
    "configs/photo_cfg/photo_default.json",
    "install/solartrigger-release-update",
}


def safe(name):
    if not isinstance(name, str) or not name or "\\" in name:
        raise RuntimeError("unsafe ZIP path")
    path = PurePosixPath(name)
    if path.is_absolute() or ".." in path.parts:
        raise RuntimeError("unsafe ZIP path")
    return path


with zipfile.ZipFile(package) as archive:
    infos = archive.infolist()
    names = [item.filename for item in infos]
    if len(names) != len(set(names)):
        raise RuntimeError("duplicate ZIP entries")
    if sum(item.file_size for item in infos) > 768 * 1024 * 1024:
        raise RuntimeError("release is too large")

    for item in infos:
        safe(item.filename)
        mode = (item.external_attr >> 16) & 0xFFFF
        if stat.S_IFMT(mode) == stat.S_IFLNK:
            raise RuntimeError("ZIP symlink rejected")

    manifest = json.loads(archive.read("manifest.json"))
    if manifest.get("package_type") != "solartrigger-release":
        raise RuntimeError("invalid package type")
    if manifest.get("schema_version") != 2:
        raise RuntimeError("unsupported package schema")

    version = str(manifest.get("version") or "").strip()
    if not version_re.fullmatch(version):
        raise RuntimeError("invalid release version")

    files = manifest.get("files")
    if not isinstance(files, dict) or not files:
        raise RuntimeError("missing release file hashes")
    if not required.issubset(files):
        raise RuntimeError("release payload is incomplete")

    expected = {f"payload/{name}" for name in files}
    actual = {
        item.filename
        for item in infos
        if item.filename.startswith("payload/") and not item.is_dir()
    }
    if actual != expected:
        raise RuntimeError("release payload does not match manifest")

    by_name = {item.filename: item for item in infos}
    for relative, metadata in files.items():
        relative_path = safe(relative)
        if str(relative_path).startswith("payload/"):
            raise RuntimeError("invalid manifest path")
        item = by_name[f"payload/{relative_path.as_posix()}"]
        expected_size = int(metadata["size"])
        expected_hash = str(metadata["sha256"]).lower()
        if item.file_size != expected_size:
            raise RuntimeError(f"size mismatch: {relative}")
        digest = hashlib.sha256()
        with archive.open(item, "r") as source:
            for chunk in iter(lambda: source.read(1024 * 1024), b""):
                digest.update(chunk)
        if digest.hexdigest() != expected_hash:
            raise RuntimeError(f"hash mismatch: {relative}")

    destination.mkdir(parents=True, exist_ok=False)
    try:
        for relative, metadata in files.items():
            relative_path = safe(relative)
            target = destination.joinpath(*relative_path.parts)
            target.parent.mkdir(parents=True, exist_ok=True)
            data = archive.read(f"payload/{relative_path.as_posix()}")
            target.write_bytes(data)
            mode_text = str(metadata.get("mode") or "0644")
            try:
                mode = int(mode_text, 8)
            except ValueError:
                mode = 0o644
            target.chmod(mode & 0o777)

        (destination / "RELEASE_MANIFEST.json").write_text(
            json.dumps(manifest, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
    except BaseException:
        import shutil
        shutil.rmtree(destination, ignore_errors=True)
        raise

print(version)
PY
}

release_version() {
    local package=$1

    /usr/bin/python3 - "$package" <<'PY'
import json
import re
import sys
import zipfile

with zipfile.ZipFile(sys.argv[1]) as archive:
    manifest = json.loads(archive.read("manifest.json"))
version = str(manifest.get("version") or "").strip()
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]{0,63}", version):
    raise SystemExit(66)
print(version)
PY
}

prepare_release_links() {
    local destination=$1

    [[ ! -e "$destination/var" ]]
    [[ ! -e "$destination/venv" ]]
    mkdir -p -- "$SHARED_VAR"
    [[ -x "$SHARED_VENV/bin/python" ]]
    ln -s -- "$SHARED_VAR" "$destination/var"
    ln -s -- "$SHARED_VENV" "$destination/venv"
}

validate_release_runtime() {
    local destination=$1

    [[ -f "$destination/app.py" ]]
    [[ -f "$destination/wsgi.py" ]]
    [[ -f "$destination/backend/runtime_daemon.py" ]]
    [[ -f "$destination/scripts/eclipse_trigger.py" ]]
    [[ -f "$destination/templates/index.html" ]]
    [[ -f "$destination/static/js/solartrigger.js" ]]

    "$SHARED_VENV/bin/python" -m py_compile \
        "$destination/app.py" \
        "$destination/wsgi.py" \
        "$destination/backend/runtime_daemon.py" \
        "$destination/scripts/eclipse_trigger.py"
}

cleanup_stale_temporary() {
    local entry

    shopt -s nullglob
    for entry in "$RELEASES"/.install-*; do
        [[ -d "$entry" ]] || continue
        log "Removing stale temporary release: $entry"
        rm -rf -- "$entry"
    done
    shopt -u nullglob
}

request_reboot() {
    sync
    log "Release switch complete. Rebooting Raspberry Pi."
    /usr/bin/systemctl reboot
}

install_release() {
    local install_package=$1
    local install_version
    local final_destination
    local temporary
    local extracted_version

    [[ -f "$install_package" ]]
    migrate_legacy_layout

    install_version=$(release_version "$install_package")
    final_destination="$RELEASES/$install_version"
    [[ ! -e "$final_destination" ]]

    cleanup_stale_temporary
    temporary="$RELEASES/.install-$install_version-$$"

    extracted_version=$(validate_and_extract "$install_package" "$temporary")
    [[ "$extracted_version" == "$install_version" ]]

    # Chown only extracted immutable release files. Shared var/venv links are
    # created afterwards so recursive ownership can never cross them.
    chown -R "$APP_USER":"$(id -gn "$APP_USER")" "$temporary"
    prepare_release_links "$temporary"
    validate_release_runtime "$temporary"

    mv -- "$temporary" "$final_destination"
    alink "$final_destination" "$ACTIVE"
    rm -f -- "$install_package"
    log "Installed SolarTrigger release: $install_version"
    request_reboot
}

rollback_release() {
    local rollback_version=$1
    local rollback_destination
    local current=""

    [[ "$rollback_version" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$ ]]

    migrate_legacy_layout
    rollback_destination="$RELEASES/$rollback_version"
    [[ -d "$rollback_destination" ]]
    [[ -f "$rollback_destination/app.py" ]]
    [[ -f "$rollback_destination/RELEASE_MANIFEST.json" ]]

    if [[ -L "$ACTIVE" ]]; then
        current=$(readlink -f "$ACTIVE")
    fi
    [[ "$current" != "$(readlink -f "$rollback_destination")" ]]

    alink "$rollback_destination" "$ACTIVE"
    # Keep the newest privileged helper. Rolling application code back must
    # never downgrade the recovery mechanism.
    log "Rolled back SolarTrigger to: $rollback_version"
    request_reboot
}

case "${1:-}" in
    install)
        install_release "${2:?}"
        ;;
    rollback)
        rollback_release "${2:?}"
        ;;
    *)
        exit 64
        ;;
esac

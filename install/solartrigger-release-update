#!/bin/bash
set -euo pipefail

APP_USER="${SOLARTRIGGER_USER:-${SUDO_USER:-airone}}"
USER_HOME="$(getent passwd "$APP_USER" | cut -d: -f6)"
[[ -n "$USER_HOME" ]]

BASE="$USER_HOME/solartrigger"
RELEASES="$BASE/releases"
SHARED_VAR="$BASE/var"
SHARED_VENV="$BASE/venv"
ACTIVE="$USER_HOME/solar-eclipse-trigger-prod"
DEV_ACTIVE="$BASE/dev-active"
SHARED_CAMERA_BASE="$SHARED_VAR/generated"
SHARED_CAMERA_PROFILES="$SHARED_CAMERA_BASE/camera_profiles"
SHARED_CAMERA_TIMING="$SHARED_CAMERA_BASE/camera_timing"
SHARED_CAMERA_CHARACTERIZATION="$SHARED_CAMERA_BASE/camera_characterization"

log() {
    printf '%s\n' "$*"
}

alink() {
    local target=$1
    local link=$2
    local tmp="${link}.new.$$"
    rm -f -- "$tmp"
    ln -s -- "$target" "$tmp"
    mv -Tf -- "$tmp" "$link"
}

ensure_shared_layout() {
    local app_group
    local path
    app_group=$(id -gn "$APP_USER")

    # This helper runs as root while persistent data are writable by APP_USER.
    # Never let a persistent-data symlink redirect privileged filesystem work.
    for path in "$BASE" "$SHARED_VAR" "$SHARED_CAMERA_BASE" \
        "$SHARED_CAMERA_PROFILES" "$SHARED_CAMERA_TIMING" \
        "$SHARED_CAMERA_CHARACTERIZATION"; do
        [[ ! -L "$path" ]] || { log "Unsafe persistent-data symlink: $path" >&2; return 1; }
    done

    mkdir -p -- \
        "$SHARED_VAR" \
        "$SHARED_CAMERA_PROFILES" \
        "$SHARED_CAMERA_TIMING" \
        "$SHARED_CAMERA_CHARACTERIZATION"

    for path in "$BASE" "$SHARED_VAR" "$SHARED_CAMERA_BASE" \
        "$SHARED_CAMERA_PROFILES" "$SHARED_CAMERA_TIMING" \
        "$SHARED_CAMERA_CHARACTERIZATION"; do
        [[ -d "$path" && ! -L "$path" ]] || { log "Unsafe persistent-data path: $path" >&2; return 1; }
    done

    chown "$APP_USER:$app_group" -- \
        "$SHARED_VAR" \
        "$SHARED_CAMERA_BASE" \
        "$SHARED_CAMERA_PROFILES" \
        "$SHARED_CAMERA_TIMING" \
        "$SHARED_CAMERA_CHARACTERIZATION"
}

merge_release_camera_data() {
    local source=$1

    ensure_shared_layout
    /usr/bin/python3 - "$source" "$SHARED_CAMERA_BASE" <<'PY'
import hashlib
import shutil
import sys
from pathlib import Path

source = Path(sys.argv[1])
shared = Path(sys.argv[2])

# Persistent camera trees are user-writable.  Reject symlinks before any
# privileged copy so a crafted persistent path can never redirect root writes.
for entry in (shared, *sorted(shared.rglob("*"))):
    if entry.is_symlink():
        raise RuntimeError(f"persistent camera symlink rejected: {entry}")

for name in ("camera_profiles", "camera_timing", "camera_characterization"):
    origin = source / "configs" / name
    destination = shared / name
    destination.mkdir(parents=True, exist_ok=True)

    if origin.is_symlink():
        if origin.resolve() != destination.resolve():
            raise RuntimeError(f"unsafe camera data symlink: {origin}")
        continue
    if not origin.exists():
        continue
    if not origin.is_dir():
        raise RuntimeError(f"camera data path is not a directory: {origin}")

    for item in sorted(origin.rglob("*")):
        if item.is_symlink():
            raise RuntimeError(f"camera data symlink rejected: {item}")
        if not item.is_file():
            continue
        relative = item.relative_to(origin)
        target = destination / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        if target.exists():
            if not target.is_file():
                raise RuntimeError(f"persistent camera path conflict: {target}")
            if hashlib.sha256(target.read_bytes()).digest() != hashlib.sha256(item.read_bytes()).digest():
                print(f"Keeping persistent camera data: {target}")
            continue
        shutil.copy2(item, target)
        print(f"Persisted camera data: {target}")
PY

    chown -R "$APP_USER:$(id -gn "$APP_USER")" -- \
        "$SHARED_CAMERA_PROFILES" \
        "$SHARED_CAMERA_TIMING" \
        "$SHARED_CAMERA_CHARACTERIZATION"
}

link_release_camera_data() {
    local destination=$1
    local name
    local shared
    local path

    merge_release_camera_data "$destination"

    for name in camera_profiles camera_timing camera_characterization; do
        case "$name" in
            camera_profiles) shared=$SHARED_CAMERA_PROFILES ;;
            camera_timing) shared=$SHARED_CAMERA_TIMING ;;
            camera_characterization) shared=$SHARED_CAMERA_CHARACTERIZATION ;;
        esac
        path="$destination/configs/$name"
        mkdir -p -- "$destination/configs"
        if [[ -L "$path" ]]; then
            [[ "$(readlink -f "$path")" == "$(readlink -f "$shared")" ]]
            continue
        fi
        if [[ -e "$path" ]]; then
            rm -rf -- "$path"
        fi
        ln -s -- "$shared" "$path"
    done
}

manifest_for_legacy() {
    local version=$1
    local destination=$2
    local commit=""

    if [[ -f "$destination/BUILD_COMMIT" ]]; then
        commit=$(tr -d '[:space:]' < "$destination/BUILD_COMMIT")
    fi

    /usr/bin/python3 - "$destination" "$version" "$commit" <<'PYLEGACY'
import hashlib
import json
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
version = sys.argv[2]
commit = sys.argv[3] or None
manifest_path = root / "RELEASE_MANIFEST.json"
mutable_prefixes = (
    "configs/camera_profiles/",
    "configs/camera_timing/",
    "configs/camera_characterization/",
    "var/",
    "venv/",
)
skip_names = {
    "RELEASE_MANIFEST.json",
    "state.json",
    "todayeclipse.json",
    "logs_buffer.jsonl",
    "sound_events.jsonl",
}
files = {}

for path in sorted(root.rglob("*")):
    relative = path.relative_to(root).as_posix()
    if path.is_symlink() or not path.is_file():
        continue
    if any(relative.startswith(prefix) for prefix in mutable_prefixes):
        continue
    if path.name in skip_names or "__pycache__" in path.parts or path.suffix in {".pyc", ".pyo"}:
        continue
    data = path.read_bytes()
    files[relative] = {
        "sha256": hashlib.sha256(data).hexdigest(),
        "size": len(data),
        "mode": f"{stat.S_IMODE(path.stat().st_mode):04o}",
    }

if not files:
    raise RuntimeError("legacy release contains no immutable files")

manifest_path.write_text(
    json.dumps(
        {
            "package_type": "solartrigger-release",
            "schema_version": 2,
            "version": version,
            "build_commit": commit,
            "migrated_legacy": True,
            "files": files,
        },
        indent=2,
        sort_keys=True,
    ) + "\n",
    encoding="utf-8",
)
PYLEGACY
}

migrate_legacy_layout() {
    local stamp
    local version
    local destination

    mkdir -p -- "$BASE" "$RELEASES"

    if [[ -e "$ACTIVE" && ! -L "$ACTIVE" ]]; then
        stamp=$(date -u +%Y%m%d-%H%M%S)
        version="legacy-$stamp"
        destination="$RELEASES/$version"
        [[ ! -e "$destination" ]]

        log "Migrating legacy installation to $destination"
        mv -- "$ACTIVE" "$destination"
        alink "$destination" "$ACTIVE"

        if [[ -e "$destination/var" && ! -L "$destination/var" ]]; then
            [[ ! -e "$SHARED_VAR" ]]
            mv -- "$destination/var" "$SHARED_VAR"
        fi
        if [[ -e "$destination/venv" && ! -L "$destination/venv" ]]; then
            [[ ! -e "$SHARED_VENV" ]]
            mv -- "$destination/venv" "$SHARED_VENV"
        fi

        ensure_shared_layout
        [[ -d "$SHARED_VENV" ]]

        if [[ ! -L "$destination/var" ]]; then
            ln -s -- "$SHARED_VAR" "$destination/var"
        fi
        if [[ ! -L "$destination/venv" ]]; then
            ln -s -- "$SHARED_VENV" "$destination/venv"
        fi

        link_release_camera_data "$destination"
        manifest_for_legacy "$version" "$destination"
    fi
}

validate_and_extract() {
    local package=$1
    local destination=$2

    /usr/bin/python3 - "$package" "$destination" <<'PY'
import hashlib
import json
from pathlib import Path, PurePosixPath
import re
import stat
import sys
import zipfile

package = Path(sys.argv[1])
destination = Path(sys.argv[2])
version_re = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$")
required = {
    "app.py",
    "wsgi.py",
    "backend/runtime_daemon.py",
    "scripts/eclipse_trigger.py",
    "templates/index.html",
    "static/js/solartrigger.js",
    "Sounds/contact.wav",
    "configs/photo_cfg/photo_default.json",
    "install/solartrigger-release-update",
}


def safe(name):
    if not isinstance(name, str) or not name or "\\" in name:
        raise RuntimeError("unsafe ZIP path")
    path = PurePosixPath(name)
    if path.is_absolute() or ".." in path.parts:
        raise RuntimeError("unsafe ZIP path")
    return path


with zipfile.ZipFile(package) as archive:
    infos = archive.infolist()
    names = [item.filename for item in infos]
    if len(names) != len(set(names)):
        raise RuntimeError("duplicate ZIP entries")
    if sum(item.file_size for item in infos) > 768 * 1024 * 1024:
        raise RuntimeError("release is too large")

    for item in infos:
        safe(item.filename)
        mode = (item.external_attr >> 16) & 0xFFFF
        if stat.S_IFMT(mode) == stat.S_IFLNK:
            raise RuntimeError("ZIP symlink rejected")

    manifest = json.loads(archive.read("manifest.json"))
    if manifest.get("package_type") != "solartrigger-release":
        raise RuntimeError("invalid package type")
    if manifest.get("schema_version") != 2:
        raise RuntimeError("unsupported package schema")

    version = str(manifest.get("version") or "").strip()
    if not version_re.fullmatch(version):
        raise RuntimeError("invalid release version")

    files = manifest.get("files")
    if not isinstance(files, dict) or not files:
        raise RuntimeError("missing release file hashes")
    if not required.issubset(files):
        raise RuntimeError("release payload is incomplete")

    expected = {f"payload/{name}" for name in files}
    actual = {
        item.filename
        for item in infos
        if item.filename.startswith("payload/") and not item.is_dir()
    }
    if actual != expected:
        raise RuntimeError("release payload does not match manifest")

    by_name = {item.filename: item for item in infos}
    for relative, metadata in files.items():
        relative_path = safe(relative)
        if str(relative_path).startswith("payload/"):
            raise RuntimeError("invalid manifest path")
        item = by_name[f"payload/{relative_path.as_posix()}"]
        expected_size = int(metadata["size"])
        expected_hash = str(metadata["sha256"]).lower()
        if item.file_size != expected_size:
            raise RuntimeError(f"size mismatch: {relative}")
        digest = hashlib.sha256()
        with archive.open(item, "r") as source:
            for chunk in iter(lambda: source.read(1024 * 1024), b""):
                digest.update(chunk)
        if digest.hexdigest() != expected_hash:
            raise RuntimeError(f"hash mismatch: {relative}")

    destination.mkdir(parents=True, exist_ok=False)
    try:
        for relative, metadata in files.items():
            relative_path = safe(relative)
            target = destination.joinpath(*relative_path.parts)
            target.parent.mkdir(parents=True, exist_ok=True)
            data = archive.read(f"payload/{relative_path.as_posix()}")
            target.write_bytes(data)
            mode_text = str(metadata.get("mode") or "0644")
            try:
                mode = int(mode_text, 8)
            except ValueError:
                mode = 0o644
            target.chmod(mode & 0o777)

        (destination / "RELEASE_MANIFEST.json").write_text(
            json.dumps(manifest, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
    except BaseException:
        import shutil
        shutil.rmtree(destination, ignore_errors=True)
        raise

print(version)
PY
}

release_version() {
    local package=$1

    /usr/bin/python3 - "$package" <<'PY'
import json
import re
import sys
import zipfile

with zipfile.ZipFile(sys.argv[1]) as archive:
    manifest = json.loads(archive.read("manifest.json"))
version = str(manifest.get("version") or "").strip()
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]{0,63}", version):
    raise SystemExit(66)
print(version)
PY
}

prepare_release_links() {
    local destination=$1

    ensure_shared_layout
    [[ -x "$SHARED_VENV/bin/python" ]]

    if [[ -L "$destination/var" ]]; then
        [[ "$(readlink -f "$destination/var")" == "$(readlink -f "$SHARED_VAR")" ]]
    else
        [[ ! -e "$destination/var" ]]
        ln -s -- "$SHARED_VAR" "$destination/var"
    fi

    if [[ -L "$destination/venv" ]]; then
        [[ "$(readlink -f "$destination/venv")" == "$(readlink -f "$SHARED_VENV")" ]]
    else
        [[ ! -e "$destination/venv" ]]
        ln -s -- "$SHARED_VENV" "$destination/venv"
    fi

    link_release_camera_data "$destination"
}

verify_release_integrity() {
    local destination=$1

    /usr/bin/python3 - "$destination" <<'PYVERIFY'
import hashlib
import json
import os
import sys
from pathlib import Path, PurePosixPath

root = Path(sys.argv[1])
manifest_path = root / "RELEASE_MANIFEST.json"
try:
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
except (OSError, json.JSONDecodeError) as exc:
    raise RuntimeError(f"invalid release manifest: {exc}") from exc

if manifest.get("package_type") != "solartrigger-release" or manifest.get("schema_version") != 2:
    raise RuntimeError("invalid release manifest identity")
files = manifest.get("files")
if not isinstance(files, dict) or not files:
    raise RuntimeError("release manifest has no immutable file hashes")

mutable_prefixes = (
    "configs/camera_profiles/",
    "configs/camera_timing/",
    "configs/camera_characterization/",
)
required = {
    "app.py",
    "wsgi.py",
    "backend/runtime_daemon.py",
    "scripts/eclipse_trigger.py",
    "templates/index.html",
    "static/js/solartrigger.js",
}
if not required.issubset(files):
    raise RuntimeError("release manifest is incomplete")

for relative, metadata in files.items():
    if any(str(relative).startswith(prefix) for prefix in mutable_prefixes):
        continue
    pure = PurePosixPath(str(relative))
    if pure.is_absolute() or ".." in pure.parts or "\\" in str(relative):
        raise RuntimeError(f"unsafe release manifest path: {relative}")
    path = root.joinpath(*pure.parts)
    if path.is_symlink() or not path.is_file():
        raise RuntimeError(f"release file missing or replaced: {relative}")
    data = path.read_bytes()
    try:
        expected_size = int(metadata["size"])
        expected_hash = str(metadata["sha256"]).lower()
    except (KeyError, TypeError, ValueError) as exc:
        raise RuntimeError(f"invalid release metadata: {relative}") from exc
    if len(data) != expected_size:
        raise RuntimeError(f"release integrity size mismatch: {relative}")
    if hashlib.sha256(data).hexdigest() != expected_hash:
        raise RuntimeError(f"release integrity hash mismatch: {relative}")

allowed_symlinks = {
    "var",
    "venv",
    "configs/camera_profiles",
    "configs/camera_timing",
    "configs/camera_characterization",
}
allowed_extra_files = {"RELEASE_MANIFEST.json"}

for current, dirs, names in os.walk(root, topdown=True, followlinks=False):
    current_path = Path(current)
    for name in [*dirs, *names]:
        path = current_path / name
        relative = path.relative_to(root).as_posix()
        if path.is_symlink():
            if relative not in allowed_symlinks:
                raise RuntimeError(f"undeclared release symlink: {relative}")
            continue
        if (
            path.is_file()
            and relative not in files
            and relative not in allowed_extra_files
        ):
            raise RuntimeError(f"undeclared release file: {relative}")

build_commit = manifest.get("build_commit")
if build_commit:
    build_path = root / "BUILD_COMMIT"
    if build_path.is_file():
        actual = build_path.read_text(encoding="utf-8").strip()
        if actual != str(build_commit).strip():
            raise RuntimeError("release BUILD_COMMIT does not match manifest")

print(f"Release integrity verified: {manifest.get('version') or root.name}")
PYVERIFY
}

seal_release() {
    local destination=$1

    /usr/bin/python3 - "$destination" <<'PYSEAL'
import os
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
for current, dirs, files in os.walk(root, topdown=False, followlinks=False):
    current_path = Path(current)
    for name in files:
        path = current_path / name
        if path.is_symlink():
            continue
        mode = stat.S_IMODE(path.stat().st_mode)
        path.chmod(mode & ~0o222)
        os.chown(path, 0, 0)
    for name in dirs:
        path = current_path / name
        if path.is_symlink():
            continue
        mode = stat.S_IMODE(path.stat().st_mode)
        path.chmod(mode & ~0o222)
        os.chown(path, 0, 0)
mode = stat.S_IMODE(root.stat().st_mode)
root.chmod(mode & ~0o222)
os.chown(root, 0, 0)
PYSEAL
}

validate_release_runtime() {
    local destination=$1

    [[ -f "$destination/app.py" ]]
    [[ -f "$destination/wsgi.py" ]]
    [[ -f "$destination/backend/runtime_daemon.py" ]]
    [[ -f "$destination/scripts/eclipse_trigger.py" ]]
    [[ -f "$destination/templates/index.html" ]]
    [[ -f "$destination/static/js/solartrigger.js" ]]

    # Compile source in memory. `python -m py_compile` writes __pycache__ into
    # the release and would make an immutable release differ from its manifest.
    "$SHARED_VENV/bin/python" - "$destination" <<'PYRUNTIME'
import sys
from pathlib import Path

root = Path(sys.argv[1])
for relative in (
    "app.py",
    "wsgi.py",
    "backend/runtime_daemon.py",
    "scripts/eclipse_trigger.py",
):
    path = root / relative
    source = path.read_text(encoding="utf-8")
    compile(source, str(path), "exec")
PYRUNTIME
}

cleanup_release_runtime_artifacts() {
    local destination=$1

    # Older installers used py_compile and could leave interpreter artefacts
    # outside the manifest. Remove only those known generated artefacts before
    # strict integrity verification.
    find "$destination" -type d -name '__pycache__' -prune -exec rm -rf -- {} +
    find "$destination" -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete
}

cleanup_stale_temporary() {
    local entry

    shopt -s nullglob
    for entry in "$RELEASES"/.install-*; do
        [[ -d "$entry" ]] || continue
        log "Removing stale temporary release: $entry"
        rm -rf -- "$entry"
    done
    shopt -u nullglob
}

make_dev_workspace_writable() {
    local destination=$1
    local app_group
    app_group=$(id -gn "$APP_USER")

    # destination is still a trusted copy of a verified immutable release here.
    # Do not call this function again after the workspace becomes user-writable.
    chown -hR "$APP_USER:$app_group" -- "$destination"
    find "$destination" -type d -exec chmod u+rwx {} +
    find "$destination" -type f -exec chmod u+rw {} +
}

prepare_dev_workspace() {
    local current=""
    local temporary=""

    migrate_legacy_layout
    ensure_shared_layout

    if [[ -L "$ACTIVE" ]]; then
        current=$(readlink -f "$ACTIVE")
    fi
    [[ -n "$current" && -d "$current" ]] || {
        log "Active SolarTrigger installation not found." >&2
        return 1
    }
    [[ ! -L "$DEV_ACTIVE" ]] || {
        log "Unsafe dev workspace symlink: $DEV_ACTIVE" >&2
        return 1
    }

    # Once dev-active is live it is intentionally writable by APP_USER.
    # Never traverse it again as root: deploy-prod.sh performs subsequent
    # synchronization directly as APP_USER.
    if [[ "$current" == "$(readlink -m "$DEV_ACTIVE")" ]]; then
        log "SolarTrigger DEV workspace already active: $DEV_ACTIVE"
        return 0
    fi

    # Only clone from a verified immutable release.
    verify_release_integrity "$current"

    temporary="$BASE/.dev-active.$$"
    rm -rf -- "$temporary"
    cp -a -- "$current" "$temporary"

    cleanup_release_runtime_artifacts "$temporary"
    rm -f --         "$temporary/RELEASE_MANIFEST.json"         "$temporary/RELEASE_VERSION"

    # Keep all mutable state outside the DEV code tree exactly as for releases.
    prepare_release_links "$temporary"

    printf '%s\n' "SolarTrigger development workspace"         > "$temporary/.solartrigger-dev-workspace"
    make_dev_workspace_writable "$temporary"

    # rm -rf does not follow symlinks and DEV_ACTIVE itself was rejected above
    # if it was a symlink.
    rm -rf -- "$DEV_ACTIVE"
    mv -- "$temporary" "$DEV_ACTIVE"
    alink "$DEV_ACTIVE" "$ACTIVE"

    log "SolarTrigger DEV workspace prepared: $DEV_ACTIVE"
}

request_reboot() {
    sync
    log "Release switch complete. Rebooting Raspberry Pi."
    /usr/bin/systemctl reboot
}

install_release() {
    local install_package=$1
    local install_version
    local final_destination
    local temporary
    local extracted_version
    local current=""

    [[ -f "$install_package" ]]
    migrate_legacy_layout

    if [[ -L "$ACTIVE" ]]; then
        current=$(readlink -f "$ACTIVE")
        if [[ -d "$current" ]]; then
            merge_release_camera_data "$current"
        fi
    fi

    install_version=$(release_version "$install_package")
    final_destination="$RELEASES/$install_version"
    [[ ! -e "$final_destination" ]]

    cleanup_stale_temporary
    temporary="$RELEASES/.install-$install_version-$$"

    extracted_version=$(validate_and_extract "$install_package" "$temporary")
    [[ "$extracted_version" == "$install_version" ]]

    prepare_release_links "$temporary"
    validate_release_runtime "$temporary"
    cleanup_release_runtime_artifacts "$temporary"
    verify_release_integrity "$temporary"
    seal_release "$temporary"

    mv -- "$temporary" "$final_destination"
    alink "$final_destination" "$ACTIVE"
    rm -f -- "$install_package"
    log "Installed SolarTrigger release: $install_version"
    request_reboot
}

rollback_release() {
    local rollback_version=$1
    local rollback_destination
    local current=""

    [[ "$rollback_version" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$ ]]

    migrate_legacy_layout
    rollback_destination="$RELEASES/$rollback_version"
    [[ -d "$rollback_destination" ]]
    [[ -f "$rollback_destination/app.py" ]]
    [[ -f "$rollback_destination/RELEASE_MANIFEST.json" ]]

    if [[ -L "$ACTIVE" ]]; then
        current=$(readlink -f "$ACTIVE")
    fi
    [[ "$current" != "$(readlink -f "$rollback_destination")" ]]

    if [[ -n "$current" && -d "$current" ]]; then
        merge_release_camera_data "$current"
    fi

    prepare_release_links "$rollback_destination"
    cleanup_release_runtime_artifacts "$rollback_destination"
    verify_release_integrity "$rollback_destination"
    seal_release "$rollback_destination"

    alink "$rollback_destination" "$ACTIVE"
    log "Rolled back SolarTrigger to: $rollback_version"
    request_reboot
}

case "${1:-}" in
    dev-prepare)
        prepare_dev_workspace
        ;;
    install)
        install_release "${2:?}"
        ;;
    rollback)
        rollback_release "${2:?}"
        ;;
    *)
        exit 64
        ;;
esac
